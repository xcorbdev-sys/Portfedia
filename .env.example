# Uygulamanın herkese açık adresi (sitemap, canonical, OG linkleri için)
SITE_URL=http://localhost:3000

# MongoDB bağlantısı (Coolify'da MongoDB kaynağının "internal URL"si)
MONGODB_URI=mongodb://localhost:27017/portfedia

# Cloudflare R2 (fotoğraf/logo depolama). Boş bırakılırsa dosyalar ./uploads klasörüne yazılır.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=portfedia-media
# Bucket'a bağlı herkese açık adres (özel alan adı veya r2.dev), sonunda / olmadan
R2_PUBLIC_URL=https://media.portfedia.com
